{
  "name": "patient-network",
  "version": "1.0.0",
  "client": {
    "tlsEnable": true,
    "adminCredential": {
      "id": "admin",
      "password": "123456"
    },
    "enableAuthentication": true,
    "organization": "PatientMSP",
    "connection": {
      "timeout": {
        "peer": {
          "endorser": "300"
        },
        "orderer": "300"
      }
    }
  },
  "channels": {
    "appchannel": {
      "peers": {
        "peer0.patient.com": {},
        "peer1.patient.com": {},
        "peer2.patient.com": {},
        "peer3.patient.com": {},
        "peer4.patient.com": {},
        "peer5.patient.com": {}
      },
      "connection": {
        "timeout": {
          "endorser": "6000",
          "eventHub": "6000",
          "eventReg": "6000"
        }
      }
    }
  },
  "organizations": {
    "PatientMSP": {
      "mspid": "PatientMSP",
      "adminPrivateKey": {
        "path": "/tmp/crypto/peerOrganizations/patient.com/users/Admin@patient.com/msp/keystore/priv_sk"
      },
      "peers": [
        "peer0.patient.com",
        "peer1.patient.com",
        "peer2.patient.com",
        "peer3.patient.com",
        "peer4.patient.com",
        "peer5.patient.com"

      ],
      "signedCert": {
        "path": "/tmp/crypto/peerOrganizations/patient.com/users/Admin@patient.com/msp/signcerts/Admin@patient.com-cert.pem"
      }
    }
  },
  "peers": {
    "peer0.patient.com": {
      "tlsCACerts": {
        "path": "/tmp/crypto/peerOrganizations/patient.com/peers/peer0.patient.com/tls/ca.crt"
      },
      "url": "grpcs://peer0.patient.com:7051"
    },
    "peer1.patient.com": {
      "tlsCACerts": {
        "path": "/tmp/crypto/peerOrganizations/patient.com/peers/peer1.patient.com/tls/ca.crt"
      },
      "url": "grpcs://peer1.patient.com:7051"
    },
    "peer2.patient.com": {
      "tlsCACerts": {
        "path": "/tmp/crypto/peerOrganizations/patient.com/peers/peer2.patient.com/tls/ca.crt"
      },
      "url": "grpcs://peer2.patient.com:7051"
    },
    "peer3.patient.com": {
      "tlsCACerts": {
        "path": "/tmp/crypto/peerOrganizations/patient.com/peers/peer3.patient.com/tls/ca.crt"
      },
      "url": "grpcs://peer3.patient.com:7051"
    },
    "peer4.patient.com": {
      "tlsCACerts": {
        "path": "/tmp/crypto/peerOrganizations/patient.com/peers/peer4.patient.com/tls/ca.crt"
      },
      "url": "grpcs://peer4.patient.com:7051"
    },
    "peer5.patient.com": {
      "tlsCACerts": {
        "path": "/tmp/crypto/peerOrganizations/patient.com/peers/peer5.patient.com/tls/ca.crt"
      },
      "url": "grpcs://peer5.patient.com:7051"
    }
  }
}